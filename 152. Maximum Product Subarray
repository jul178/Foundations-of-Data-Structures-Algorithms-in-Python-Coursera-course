class Solution:
    def maxProduct(self, nums: List[int]) -> int:
        max_pr = nums[0]
        min_pr = nums[0]
        result = nums[0]
        
        for i in range(1, len(nums)):
            if nums[i] >= 0:
                max_pr = max(max_pr * nums[i], nums[i])
                min_pr = min(min_pr * nums[i], nums[i])
            else:
                temp = max_pr
                max_pr = max(min_pr * nums[i], nums[i])
                min_pr = min(temp * nums[i], nums[i])

            if max_pr > result:
                result = max_pr

        return result
        
