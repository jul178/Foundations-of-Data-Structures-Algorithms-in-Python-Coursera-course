class Solution:
    def maxProfit(self, prices: List[int]) -> int:
        res = 0
        min_val = 0
        max_val = prices[0]
        for i in range(1, len(prices)):
            if max_val > prices[i]:
                max_val = prices[i]
            else:
                min_val = prices[i] - max_val

            if min_val > res:
                res = min_val
                
        return res
