class Solution:
    def longestConsecutive(self, nums: List[int]) -> int:
        nSet = set(nums)
        ans = 0
        for n in nSet:
            if n - 1 not in nSet:
                curr = n
                curr_streak = 1

                while curr + 1 in nSet:
                    curr_streak += 1
                    curr += 1

                if curr_streak > ans:
                    ans = curr_streak
        return ans

           
