class Solution:
    def isValidSudoku(self, board: List[List[str]]) -> bool:
        row_set = [set() for _ in range(9)]
        col_set = [set() for _ in range(9)]
        grid_set = [set() for _ in range(9)]

        for i in range(9):
            for j in range(9):
                if board[i][j] == '.':
                    continue
                
                gridNo = (i//3)*3 + (j//3)
                is_present_in_row = board[i][j] in row_set[i]
                is_present_in_col = board[i][j] in col_set[j]
                is_present_in_grid = board[i][j] in grid_set[gridNo]

                if is_present_in_row or is_present_in_col or is_present_in_grid:
                    return False

                row_set[i].add(board[i][j])
                col_set[j].add(board[i][j])
                grid_set[gridNo].add(board[i][j])
        return True
        
