class Solution:
    def maxSubArray(self, nums: List[int]) -> int:
        if all(n >= 0 for n in nums):
            return sum(nums)
        max_sum = nums[0]
        curr_sum = nums[0]
        for i in range(1, len(nums)):
            if curr_sum < 0:
                curr_sum = 0
            curr_sum += nums[i]
            if curr_sum > max_sum:
                max_sum = curr_sum
            
        return max_sum
