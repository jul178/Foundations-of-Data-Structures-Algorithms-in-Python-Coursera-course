# Definition for singly-linked list.
class ListNode:
    def __init__(self, x):
        self.val = x
        self.next = None

class Solution:
    def getIntersectionNode(self, headA: ListNode, headB: ListNode) -> Optional[ListNode]:
        length_B = self.length(headB)
        length_A = self.length(headA)
        probe_A = headA
        probe_B = headB
        if length_B >= length_A:
            for i in range(length_B - length_A):
                probe_B = probe_B.next
        else:
            for i in range(length_A - length_B):
                probe_A = probe_A.next

        while probe_A is not None and probe_B is not None:
            if probe_A == probe_B:
                return probe_A
            probe_A = probe_A.next
            probe_B = probe_B.next


    def length(self, head):
        length = 0
        probe = head
        while probe is not None:
            length += 1
            probe = probe.next
        return length
